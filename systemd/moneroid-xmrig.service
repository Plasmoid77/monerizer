[Unit]
Description=XMRig (Moneroid)
Documentation=https://xmrig.com/docs/miner
After=network-online.target moneroid-p2pool.service
Wants=network-online.target
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=exec
User=moneroid-xmrig
Group=moneroid
ExecStart=/usr/local/bin/xmrig --config /etc/moneroid/xmrig.json
WorkingDirectory=/var/lib/moneroid/xmrig
StateDirectory=moneroid/xmrig
StateDirectoryMode=0700
UMask=0027
StandardInput=null
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillMode=control-group
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
