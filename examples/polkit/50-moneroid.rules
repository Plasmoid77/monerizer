// Optional rule (SEC-03): group moneroid may start/stop/restart (and
// reset-failed after a start-limit-hit) exactly two units without a password.
// Install to /etc/polkit-1/rules.d/50-moneroid.rules (polkit >= 0.106).
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        subject.isInGroup("moneroid")) {
        var unit = action.lookup("unit");
        var verb = action.lookup("verb");
        if ((unit == "moneroid-p2pool.service" || unit == "moneroid-xmrig.service") &&
            (verb == "start" || verb == "stop" || verb == "restart" || verb == "reset-failed")) {
            return polkit.Result.YES;
        }
    }
});
