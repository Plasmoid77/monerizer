// Опциональное правило SEC-03: группа moneroid может start/stop/restart
// (и reset-failed после start-limit-hit) ровно двух units без пароля. Установка: /etc/polkit-1/rules.d/50-moneroid.rules
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        subject.isInGroup("moneroid")) {
        var unit = action.lookup("unit");
        var verb = action.lookup("verb");
        if ((unit == "moneroid-p2pool.service" || unit == "moneroid-xmrig.service") &&
            (verb == "start" || verb == "stop" || verb == "restart" || verb == "reset-failed")) {
            return polkit.Result.YES;
        }
    }
});
