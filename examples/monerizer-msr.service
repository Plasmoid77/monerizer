# Опционально, только Intel: отключает аппаратные префетчеры (MSR 0x1a4 = 0xf) —
# то, что XMRig делал бы сам под root («MSR mod»). На Zeonux (Xeon E5 v4): +4,5 % hashrate.
# Требует msr-tools. Установка: /etc/systemd/system/, systemctl enable --now monerizer-msr.service
# Откат: systemctl disable --now monerizer-msr.service (ExecStop возвращает 0x0) или перезагрузка.
[Unit]
Description=RandomX MSR tweak for XMRig (Intel, disables HW prefetchers)
Documentation=https://xmrig.com/docs/miner/randomx-optimization-guide
Before=monerizer-xmrig.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/sbin/modprobe msr
ExecStart=/usr/sbin/wrmsr -a 0x1a4 0xf
ExecStop=/usr/sbin/wrmsr -a 0x1a4 0x0

[Install]
WantedBy=multi-user.target
