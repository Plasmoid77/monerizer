# Optional, Intel only: disables the hardware prefetchers (MSR 0x1a4 = 0xf) —
# what XMRig would do itself as root ("MSR mod"). On a Xeon E5 v4: +4.5 % hashrate.
# Needs msr-tools. Install to /etc/systemd/system/, then systemctl enable --now moneroid-msr.service
# Rollback: systemctl disable --now moneroid-msr.service (ExecStop writes 0x0) or reboot.
[Unit]
Description=RandomX MSR tweak for XMRig (Intel, disables HW prefetchers)
Documentation=https://xmrig.com/docs/miner/randomx-optimization-guide
Before=moneroid-xmrig.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/sbin/modprobe msr
ExecStart=/usr/sbin/wrmsr -a 0x1a4 0xf
ExecStop=/usr/sbin/wrmsr -a 0x1a4 0x0

[Install]
WantedBy=multi-user.target
